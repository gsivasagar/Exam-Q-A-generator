# Base URL of your Ollama HTTP server (default local)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for question generation and grading
OLLAMA_MODEL=gemma3:latest

# Optional: Gemini (can also be entered in the sidebar)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional LLM call tuning
# LLM_TIMEOUT=300            # seconds per request
# LLM_MAX_RETRIES=2          # retries on timeouts / 429 / 5xx
# LLM_RETRY_BACKOFF=1        # seconds, doubles each retry
# OLLAMA_NUM_CTX=8192        # context window; unset = Ollama default
# GEMINI_THINKING_BUDGET=0   # cap Gemini thinking tokens (0 disables on 2.5 Flash) to cut cost

# Embedding model: default (built-in MiniLM) or ollama:<model>, e.g. ollama:bge-m3,
# ollama:nomic-embed-text. Switching creates a separate store; run `ollama pull <model>` first.
# EMBEDDING_MODEL=default

# Topic retrieval: auto (default: hybrid BM25 + dense for documents of at least HYBRID_MIN_CHUNKS chunks, dense
# below that), dense, or hybrid. Optional reranker: fastembed:<model> (pip install fastembed).
# RETRIEVAL_MAX_DISTANCE drops far-away dense hits.
# RETRIEVAL_MODE=auto
# HYBRID_MIN_CHUNKS=20
# RERANKER=none
# RERANK_CANDIDATES=20
# RETRIEVAL_MAX_DISTANCE=

# How chunks are chosen for each quiz batch: coverage (default) or random
# SELECTION_STRATEGY=coverage

# Short-answer grading: rubric (key points covered, scored in code) or holistic (model gives 0-1)
# GRADING_MODE=rubric

# Logging: LOG_LEVEL=INFO|DEBUG|WARNING, LOG_FORMAT=text|json (one JSON object per line)
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# Retention and limits
# DOC_TTL_DAYS=7             # forget uploaded documents from the vector store after this many days (0 = never)
# MAX_UPLOAD_MB=25
# MAX_PDF_PAGES=300
# OCR_MODE=auto              # off = never read scanned pages or images
# OCR_MAX_PAGES=30           # Gemini reads scans one page per call; longer scans are refused

# Where the vector store and results DB live
DATA_DIR=data

# HTTP API and accounts (run with: uvicorn app.api.main:app)
# APP_ENV=development        # production refuses to start without AUTH_SECRET and sets cookies Secure
# AUTH_SECRET=               # at least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ORIGIN=http://localhost:5173   # the only web page allowed to call the API (CORS and the cookie check)
# ACCESS_TTL_MIN=15          # access token lifetime
# REFRESH_TTL_DAYS=30        # "keep me signed in" lifetime (otherwise SESSION_TTL_HOURS=12)
# GUEST_TTL_DAYS=7           # guest data is deleted after this many days
# GUEST_MAX_FILES=3
# GUEST_MAX_UPLOAD_MB=10
# COOKIE_SECURE=0            # 1 in production (set automatically when APP_ENV=production)
# TRUSTED_PROXY_HOPS=0       # number of reverse proxies in front of the API (1 on Render)


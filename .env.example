# Base URL of your Ollama HTTP server (default local)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for question generation and grading
OLLAMA_MODEL=gemma3:latest

# Optional: Gemini (can also be entered in the sidebar)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional LLM call tuning
# LLM_TIMEOUT=300            # seconds per request
# LLM_MAX_RETRIES=2          # retries on timeouts / 429 / 5xx
# LLM_RETRY_BACKOFF=1        # seconds, doubles each retry
# OLLAMA_NUM_CTX=8192        # context window; unset = Ollama default
# GEMINI_THINKING_BUDGET=0   # cap Gemini thinking tokens (0 disables on 2.5 Flash) to cut cost

# Embedding model: default (built-in MiniLM) or ollama:<model>, e.g. ollama:bge-m3,
# ollama:nomic-embed-text. Switching creates a separate store; run `ollama pull <model>` first.
# EMBEDDING_MODEL=default

# Topic retrieval: dense (default) or hybrid (BM25 + dense). Optional reranker: fastembed:<model>
# (pip install fastembed). RETRIEVAL_MAX_DISTANCE drops far-away dense hits.
# RETRIEVAL_MODE=dense
# RERANKER=none
# RERANK_CANDIDATES=20
# RETRIEVAL_MAX_DISTANCE=

# How chunks are chosen for each quiz batch: coverage (default) or random
# SELECTION_STRATEGY=coverage

# Where the vector store and results DB live
DATA_DIR=data
